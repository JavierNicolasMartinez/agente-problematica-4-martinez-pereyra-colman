# Copiar a .env (o exportar las variables) para cambiar la configuración.
PORT=3001
HOST=127.0.0.1
NODE_ENV=development
# Orígenes que pueden llamar a la API desde el navegador (separados por coma).
ORIGENES_PERMITIDOS=http://localhost:5173,http://127.0.0.1:5173
# Diferencia (%) a partir de la cual se considera significativa.
UMBRAL_SIGNIFICATIVO_PCT=10
MAX_PRODUCTOS_POR_CONSULTA=120
CONSULTAS_POR_MINUTO=30
